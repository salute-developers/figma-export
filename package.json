{
  "name": "@salutejs/figma-parsers",
  "version": "1.0.0",
  "description": "Figma icon plugins monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": "24.11.1",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.18.0",
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:parserOld": "npm run build --workspace=@salutejs/parser-old",
    "build:parserNew": "npm run build --workspace=@salutejs/parser-new",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "watch:parserOld": "npm run watch --workspace=@salutejs/parser-old",
    "watch:parserNew": "npm run watch --workspace=@salutejs/parser-new"
  },
  "author": "Salute Frontend Team <salute.developers@gmail.com>"
}
